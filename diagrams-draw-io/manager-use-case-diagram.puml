@startuml
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Admin / Manager" as Manager

rectangle "Analytics Dashboard System" {
  usecase "Login" as Login
  usecase "Logout" as Logout
  usecase "View Manager\nDashboard" as ViewDashboard
  usecase "View Dashboard\nSummary Metrics" as ViewSummary
  usecase "View Analytics\nCharts" as ViewCharts
  usecase "View Students" as ViewStudents
  usecase "View Student\nDetails" as ViewStudentDetails
  usecase "Filter Student\nAnalytics" as FilterStudentAnalytics
  usecase "View Institutes" as ViewInstitutes
  usecase "View Courses" as ViewCourses
  usecase "View Course\nCompletion" as ViewCourseCompletion
  usecase "View Course\nViews" as ViewCourseViews
  usecase "View Popular\nCourses" as ViewPopularCourses
  usecase "View User\nActivity" as ViewUserActivity
  usecase "View Learning\nPerformance" as ViewLearningPerformance
  usecase "Preview Reports" as PreviewReports
  usecase "Manage Account\nSettings" as ManageSettings

  usecase "Manage System\nUsers" as ManageUsers
  usecase "Search / Filter\nUsers" as FilterUsers
  usecase "Create User" as CreateUser
  usecase "Update User" as UpdateUser
  usecase "Delete User" as DeleteUser
  usecase "Reset User\nPassword" as ResetPassword

  usecase "Review Partner\nRequests" as ReviewPartnerRequests
  usecase "Search / Filter\nPartner Requests" as FilterPartnerRequests
  usecase "View Request\nDetails" as ViewRequestDetails
  usecase "Approve Partner\nRequest" as ApprovePartnerRequest
  usecase "Reject Partner\nRequest" as RejectPartnerRequest
  usecase "Create Partner\nAccount" as CreatePartnerAccount
}

Manager --> Login
Manager --> Logout
Manager --> ViewDashboard
Manager --> ViewStudents
Manager --> ViewInstitutes
Manager --> ViewCourses
Manager --> ViewUserActivity
Manager --> ViewLearningPerformance
Manager --> PreviewReports
Manager --> ManageSettings
Manager --> ManageUsers
Manager --> ReviewPartnerRequests

ViewDashboard ..> ViewSummary : <<include>>
ViewDashboard ..> ViewCharts : <<include>>

ViewStudents ..> ViewStudentDetails : <<include>>
ViewStudents ..> FilterStudentAnalytics : <<include>>

ViewCourses ..> ViewCourseCompletion : <<include>>
ViewCourses ..> ViewCourseViews : <<include>>
ViewCourses ..> ViewPopularCourses : <<include>>

ManageUsers ..> FilterUsers : <<include>>
ManageUsers ..> CreateUser : <<include>>
ManageUsers ..> UpdateUser : <<include>>
ManageUsers ..> DeleteUser : <<include>>
ManageUsers ..> ResetPassword : <<include>>

ReviewPartnerRequests ..> FilterPartnerRequests : <<include>>
ReviewPartnerRequests ..> ViewRequestDetails : <<include>>
ReviewPartnerRequests ..> ApprovePartnerRequest : <<extend>>
ReviewPartnerRequests ..> RejectPartnerRequest : <<extend>>
ApprovePartnerRequest ..> CreatePartnerAccount : <<include>>
@enduml
