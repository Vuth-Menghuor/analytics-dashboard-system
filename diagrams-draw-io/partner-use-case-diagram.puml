@startuml
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Partner" as Partner

rectangle "Analytics Dashboard System" {
  usecase "Submit Partner\nRegistration Request" as SubmitPartnerRequest
  usecase "Upload Institute\nAffiliation Document" as UploadDocument
  usecase "Login" as Login
  usecase "Logout" as Logout
  usecase "View Partner\nDashboard" as ViewDashboard
  usecase "View Dashboard\nSummary Metrics" as ViewSummary
  usecase "View Analytics\nCharts" as ViewCharts
  usecase "View Students" as ViewStudents
  usecase "View Student\nDetails" as ViewStudentDetails
  usecase "Filter Student\nAnalytics" as FilterStudentAnalytics
  usecase "View Courses" as ViewCourses
  usecase "View Course\nCompletion" as ViewCourseCompletion
  usecase "View Course\nViews" as ViewCourseViews
  usecase "View Popular\nCourses" as ViewPopularCourses
  usecase "View User\nActivity" as ViewUserActivity
  usecase "View Learning\nPerformance" as ViewLearningPerformance
  usecase "Preview Reports" as PreviewReports
  usecase "Manage Account\nSettings" as ManageSettings
}

Partner --> SubmitPartnerRequest
SubmitPartnerRequest ..> UploadDocument : <<include>>

Partner --> Login
Partner --> Logout
Partner --> ViewDashboard
Partner --> ViewStudents
Partner --> ViewCourses
Partner --> ViewUserActivity
Partner --> ViewLearningPerformance
Partner --> PreviewReports
Partner --> ManageSettings

ViewDashboard ..> ViewSummary : <<include>>
ViewDashboard ..> ViewCharts : <<include>>

ViewStudents ..> ViewStudentDetails : <<include>>
ViewStudents ..> FilterStudentAnalytics : <<include>>

ViewCourses ..> ViewCourseCompletion : <<include>>
ViewCourses ..> ViewCourseViews : <<include>>
ViewCourses ..> ViewPopularCourses : <<include>>
@enduml
