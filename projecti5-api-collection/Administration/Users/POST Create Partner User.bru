meta {
  name: POST Create Partner User
  type: http
  seq: 3
}

post {
  url: http://127.0.0.1:8000/api/admin/users
  body: json
  auth: inherit
}

headers {
  Accept: application/json
  Content-Type: application/json
  Authorization: Bearer {{manager_token}}
}

body:json {
  {
    "name": "Manual Partner User",
    "email": "manual.partner@example.com",
    "role": "partner",
    "institution_name": "ITC",
    "password": "password",
    "password_confirmation": "password"
  }
}

settings {
  encodeUrl: true
}
