meta {
  name: PATCH Change User Role
  type: http
  seq: 5
}

patch {
  url: http://127.0.0.1:8000/api/admin/users/1/role
  body: json
  auth: inherit
}

headers {
  Accept: application/json
  Content-Type: application/json
  Authorization: Bearer {{manager_token}}
}

body:json {
  {
    "role": "partner"
  }
}

settings {
  encodeUrl: true
}
