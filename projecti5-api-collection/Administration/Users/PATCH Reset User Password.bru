meta {
  name: PATCH Reset User Password
  type: http
  seq: 6
}

patch {
  url: http://127.0.0.1:8000/api/admin/users/1/password
  body: json
  auth: inherit
}

headers {
  Accept: application/json
  Content-Type: application/json
  Authorization: Bearer {{manager_token}}
}

body:json {
  {
    "password": "newpassword",
    "password_confirmation": "newpassword"
  }
}

settings {
  encodeUrl: true
}
