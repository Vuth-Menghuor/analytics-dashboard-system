meta {
  name: Register Account
  type: http
  seq: 3
}

post {
  url: http://127.0.0.1:8000/api/register
  body: json
  auth: inherit
}

headers {
  Accept: application/json
}

body:json {
  {
    "name": "Visitor User",
    "email": "new.visitor@example.com",
    "password": "password",
    "password_confirmation": "password",
    "role": "visitor"
  }
}

settings {
  encodeUrl: true
}
