<mxfile host="app.diagrams.net">
  <diagram name="Database Schema" id="ccun-database-schema">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Database Schema of the Analytics Dashboard System" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="800" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Current project focus: student activity, active/inactive status, institution analytics, course enrollment, course views, and CSV reports." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#4B5563;" vertex="1" parent="1">
          <mxGeometry x="250" y="60" width="900" height="30" as="geometry" />
        </mxCell>

        <mxCell id="users" value="&lt;b&gt;users&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; id&lt;br&gt;name&lt;br&gt;email UNIQUE&lt;br&gt;email_verified_at&lt;br&gt;password&lt;br&gt;role&lt;br&gt;institution_name&lt;br&gt;remember_token&lt;br&gt;created_at&lt;br&gt;updated_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#E0F2FE;strokeColor=#0369A1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="130" width="230" height="230" as="geometry" />
        </mxCell>
        <mxCell id="partner_requests" value="&lt;b&gt;partner_requests&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; id&lt;br&gt;state_province&lt;br&gt;first_name&lt;br&gt;last_name&lt;br&gt;email UNIQUE&lt;br&gt;phone_number&lt;br&gt;institution_name&lt;br&gt;id_card_path&lt;br&gt;password&lt;br&gt;status&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; reviewed_by → users.id&lt;br&gt;reviewed_at&lt;br&gt;rejection_reason&lt;br&gt;created_at&lt;br&gt;updated_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#E0F2FE;strokeColor=#0369A1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="430" width="260" height="330" as="geometry" />
        </mxCell>

        <mxCell id="students" value="&lt;b&gt;analytics_clean.students&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; id&lt;br&gt;username&lt;br&gt;firstname&lt;br&gt;lastname&lt;br&gt;email&lt;br&gt;gender&lt;br&gt;institution&lt;br&gt;department&lt;br&gt;city&lt;br&gt;country&lt;br&gt;suspended&lt;br&gt;confirmed&lt;br&gt;deleted&lt;br&gt;lastlogin&lt;br&gt;lastaccess" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ECFDF5;strokeColor=#047857;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="120" width="260" height="320" as="geometry" />
        </mxCell>
        <mxCell id="teachers" value="&lt;b&gt;analytics_clean.teachers&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; id&lt;br&gt;username&lt;br&gt;firstname&lt;br&gt;lastname&lt;br&gt;email&lt;br&gt;gender&lt;br&gt;institution&lt;br&gt;department&lt;br&gt;city&lt;br&gt;country&lt;br&gt;role_name&lt;br&gt;suspended&lt;br&gt;confirmed&lt;br&gt;deleted&lt;br&gt;lastlogin&lt;br&gt;lastaccess" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ECFDF5;strokeColor=#047857;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="500" width="260" height="330" as="geometry" />
        </mxCell>

        <mxCell id="courses" value="&lt;b&gt;analytics_clean.courses&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; id&lt;br&gt;course_name&lt;br&gt;shortname&lt;br&gt;category&lt;br&gt;visible&lt;br&gt;start_date&lt;br&gt;end_date&lt;br&gt;raw_course_name&lt;br&gt;course_group&lt;br&gt;course_group_status&lt;br&gt;data_quality_status&lt;br&gt;recommended_action&lt;br&gt;category_name" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FEF3C7;strokeColor=#B45309;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="780" y="120" width="280" height="290" as="geometry" />
        </mxCell>
        <mxCell id="enrollments" value="&lt;b&gt;analytics_clean.enrollments&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; enrolment_id&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; userid → students.id&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; courseid → courses.id&lt;br&gt;course_name&lt;br&gt;status&lt;br&gt;start_time&lt;br&gt;end_time&lt;br&gt;created_time" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FEF3C7;strokeColor=#B45309;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="790" y="490" width="280" height="210" as="geometry" />
        </mxCell>

        <mxCell id="activity_logs" value="&lt;b&gt;mdl_logstore_standard_log&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; id&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; userid → students.id&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; courseid → courses.id&lt;br&gt;component&lt;br&gt;action&lt;br&gt;target&lt;br&gt;eventname&lt;br&gt;timecreated" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#F3E8FF;strokeColor=#7E22CE;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1130" y="140" width="250" height="210" as="geometry" />
        </mxCell>
        <mxCell id="user_activity" value="&lt;b&gt;analytics_clean.user_activity&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK / FK&lt;/b&gt; userid → students.id&lt;br&gt;username&lt;br&gt;firstname&lt;br&gt;lastname&lt;br&gt;email&lt;br&gt;last_login_time&lt;br&gt;suspended&lt;br&gt;confirmed&lt;br&gt;deleted" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#F3E8FF;strokeColor=#7E22CE;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1130" y="460" width="250" height="220" as="geometry" />
        </mxCell>

        <mxCell id="note" value="Note: Grades, scores, quiz attempts, assignment submissions, and course completion-rate tables are intentionally excluded because this project focuses on active/inactive student analytics and Moodle activity logs." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#FEE2E2;strokeColor=#B91C1C;fontSize=12;fontColor=#7F1D1D;" vertex="1" parent="1">
          <mxGeometry x="770" y="760" width="610" height="70" as="geometry" />
        </mxCell>

        <mxCell id="edge_reviewed_by" value="reviews" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#374151;fontSize=11;" edge="1" parent="1" source="users" target="partner_requests">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_student_enrollments" value="has enrollments" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#374151;fontSize=11;" edge="1" parent="1" source="students" target="enrollments">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_course_enrollments" value="contains enrollments" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#374151;fontSize=11;" edge="1" parent="1" source="courses" target="enrollments">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_student_logs" value="generates logs" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#374151;fontSize=11;" edge="1" parent="1" source="students" target="activity_logs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_course_logs" value="appears in logs" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#374151;fontSize=11;" edge="1" parent="1" source="courses" target="activity_logs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_student_user_activity" value="has activity summary" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#374151;fontSize=11;" edge="1" parent="1" source="students" target="user_activity">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
